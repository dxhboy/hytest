# 忽略虚拟环境及项目产生的临时文件
.venv/
venv/
.idea/
.claude/
.superpowers/
.vscode/
.trae/
__pycache__/
.DS_Store
.pytest_cache
备注笔记.txt
# 忽略log文件
logs/*
!logs/.gitkeep
# 忽略.env配置文件(但保留.env.example示例文件)
.env
.sql
static_files/img/
.bak
# 忽略所有 app/*/migrations/ 目录下的所有内容 (包括文件和子目录)
apps/*/migrations/*
# 使用否定模式，例外地跟踪 __init__.py 文件
!apps/*/migrations/__init__.py

# 忽略media下的子目录及文件，但保留.gitkeep文件
media/allure-reports/*
!media/allure-reports/.gitkeep
media/allure-results/*
!media/allure-results/.gitkeep
media/requirement_docs/*
!media/requirement_docs/.gitkeep
media/ai_recording/*
!media/ai_recording/.gitkeep

# 忽略前端文件
frontend/node_modules/
frontend/.DS_Store
frontend/*.log
frontend/dist/

# workspace 项目数据（需求文档、生成产物不入库，目录结构保留）
workspace/projects/*/requirements/*
!workspace/projects/*/requirements/.gitkeep
workspace/projects/*/testcases/*
!workspace/projects/*/testcases/.gitkeep
workspace/projects/*/api-scripts/*
!workspace/projects/*/api-scripts/.gitkeep
workspace/projects/*/ui-scripts/*
!workspace/projects/*/ui-scripts/.gitkeep

# Allure CLI (install via package manager)
allure/

# Client config with secrets
client/config.json
# 远程浏览器客户端运行时下载的依赖（如 selenium-server jar，体积大，不入库）
client/lib/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore
nginx.conf
Makefile
build-multiplatform.sh
# Celery Beat 本地调度状态
celerybeat-schedule*
