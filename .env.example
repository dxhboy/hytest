# ================================
# Docker镜像配置 - Docker Hub 示例
# 不用docker部署可以忽略
# ================================
# Docker Hub 配置 (留空或使用 docker.io)
DOCKER_REGISTRY=https://hub.docker.com/
DOCKER_NAMESPACE=your-namespace
IMAGE_VERSION=latest

# ================================
# 服务端口配置,不用docker部署可以忽略
# ================================
# 前端服务端口
FRONTEND_PORT=80
# 后端服务端口
BACKEND_PORT=8000
# 宿主机访问MySQL的端口（用于本地开发）
DB_PORT=3306
# 容器内部访问MySQL的端口（Docker网络内部通信）
DB_INTERNAL_PORT=3306

# ================================
# Django配置
# ================================
# Django密钥：DEBUG=False 时必须设置为强随机值，否则服务拒绝启动。生成方式：
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production
# 调试模式：未配置时默认 False（按生产环境处理），本地开发请显式设为 True
DEBUG=True
# 允许的主机列表（生产环境请指定具体域名）
ALLOWED_HOSTS=*
# 允许的跨域来源（多个用逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# CSRF 受信任来源（多个用逗号分隔，需带协议，如 https://testhub.example.com）；
# 通过域名/IP 访问 Django Admin 或使用 Session 认证提交表单时必须配置，DEBUG=True 时会自动追加本地开发地址
# CSRF_TRUSTED_ORIGINS=https://testhub.example.com
# 前端访问地址（通知中的报告链接等使用）
# SITE_BASE_URL=http://localhost:3000
# Django Admin（simpleui）左上角首页图标跳转地址，默认同 SITE_BASE_URL
# SIMPLEUI_INDEX=http://localhost:3000
# 是否由 Django 直接提供 /media/ 文件（Allure 报告、截图等），默认 True；
# 生产环境建议由 nginx 直接托管 media 目录（location /media/ { alias <项目目录>/media/; }）并设为 False
# SERVE_MEDIA=True
# 修改接口请求断言时，自动同步到"原样复制"了该断言的测试套件步骤（已单独修改过的步骤不受影响）
# API_SUITE_ASSERTION_SYNC=True

# ================================
# 数据库配置
# ================================
# 数据库名称
DB_NAME=testhub
# 数据库用户名
DB_USER=root
# 数据库密码
DB_PASSWORD=your-database-password
# 数据库持久连接时长（秒），0 表示每个请求结束后关闭连接；复用前会自动做连接健康检查
# DB_CONN_MAX_AGE=60
# 运行测试时使用的测试库名（多人/多任务并行跑测试时各自指定，避免互相覆盖）
# DB_TEST_NAME=test_testhub

# ================================
# Redis / Celery 配置（UI自动化的套件执行、AI智能模式都依赖 Celery 任务队列）
# ================================
# 连接串格式：redis://[:password@]host:port/db，注意冒号后面是密码不是主机地址
REDIS_URL=redis://127.0.0.1:6379/0
# Django 缓存使用的 Redis（缓存键统一带 testhub 前缀，不会与 Celery 的键冲突），默认同 REDIS_URL；
# 也可以指定单独的库，如 redis://127.0.0.1:6379/1。REDIS_URL 与本项均未配置时回退为进程内缓存（仅适合单进程开发）
# CACHE_REDIS_URL=redis://127.0.0.1:6379/1

# ================================
# 邮件配置（可选,用于定时任务通知）
# ================================
EMAIL_HOST=smtp.163.com
# 465 端口使用 SSL；587 端口使用 TLS（二选一）
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# 日志配置
# 日志级别：DEBUG/INFO/WARNING/ERROR，默认 INFO（控制台与 logs/app.log 共用，logs/error.log 固定只记录 ERROR）
# LOG_LEVEL=INFO
# 单个日志文件滚动大小（字节，默认 10MB）与保留的历史文件个数（默认 5）
# LOG_FILE_MAX_BYTES=10485760
# LOG_FILE_BACKUP_COUNT=5

# 本地化配置
# 语言: 'en-us' (英语), 'zh-hans' (简体中文), 'ja' (日语), 'ko' (韩语) 等
# 时区: 参考 https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai

# ================================
# 生产环境注意事项
# ================================
# 1. 请务必修改SECRET_KEY为强密钥
# 2. 设置DEBUG=False
# 3. 在ALLOWED_HOSTS中指定具体域名，不要使用*
# 4. 在CORS_ALLOWED_ORIGINS中指定具体的前端域名
# 5. 使用环境变量管理敏感信息，不要提交到版本控制
# 6. 确保数据库密码足够强壮
# 7. 邮件配置使用真实的SMTP服务
# 8. 由 nginx 托管 /media/ 并设置 SERVE_MEDIA=False；配置 CSRF_TRUSTED_ORIGINS 为实际访问域名
